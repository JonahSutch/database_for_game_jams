<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - Indie Game Jam Manager</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <h1 class="logo"><a href="/">IGJM</a></h1>
            <ul class="nav-menu">
                <li><a href="/">Home</a></li>
                <li><a href="/jams">Jams</a></li>
                <li><a href="/participants">Participants</a></li>
                <li><a href="/teams">Teams</a></li>
                <li><a href="/games">Games</a></li>
                <li><a href="/tools">Tools</a></li>
                <li><a href="/game-participants">Game Participants</a></li>
                <li><a href="/game-tools">Game Tools</a></li>
                <li><button id="reset-db-btn" class="reset-btn">RESET DATABASE</button></li>
            </ul>
        </div>
    </nav>

    <main class="container">
        <h1 class="page-title">{{title}}</h1>
        {{{body}}}
    </main>

    <footer>
        <p>&copy; 2025 CS340 Group 73 - Rehjii Martin & Jonah Sutch</p>
    </footer>

    <script>
        // RESET DATABASE button functionality
        document.getElementById('reset-db-btn').addEventListener('click', function() {
            if (confirm('WARNING: This will delete ALL data and reset the database to its initial state. Are you sure you want to continue?')) {
                fetch('/reset-database', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Database reset successfully! The page will now reload.');
                        window.location.reload();
                    } else {
                        alert('Error: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while resetting the database.');
                });
            }
        });
    </script>
</body>
</html>
